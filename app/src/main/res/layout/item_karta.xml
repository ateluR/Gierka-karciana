<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#2A2A2A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/imgKartaInventory"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo" />

        <TextView
            android:id="@+id/tvNazwaKartyInventory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Nazwa Karty"
            android:textColor="#FBCC62"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvWartoscKartyInventory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="100.00 PLN"
            android:textColor="#4CAF50"
            android:textSize="12sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnSellSingle"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:text="Sprzedaj"
            android:textSize="10sp"
            android:padding="0dp"
            android:backgroundTint="#FF5252"
            android:textColor="#FBCC62" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
